# ── Cloud Functions environment ────────────────────────────────────────────────
# The Functions runtime reads these variables (declared with firebase-functions
# params/secrets in `functions/src/helpers.ts`). Without them, deploys fail
# (missing secrets) or bot/admin flows break at runtime.
#
# How this file is used by the Firebase CLI:
#   - `functions/.env`            → loaded by the emulator AND production deploys
#   - `functions/.env.local`      → emulator only
#   - `functions/.env.prod`       → production deploys only (overrides `.env`)
# Copy this file to `functions/.env` locally. NEVER commit `functions/.env`
# (it is gitignored) — this `.env.example` is the safe template.
#
# ── Setup checklist before `firebase deploy --only functions` ────────────────
# 1. Create the two SECRETS in Secret Manager (secrets can NOT be set from a
#    .env file — the deploy will fail if these do not exist):
#      firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#      firebase functions:secrets:set TELEGRAM_WEBHOOK_SECRET
#    (add `--data-file <file>` to set them non-interactively, e.g. in CI)
# 2. Set the three plain params below in `functions/.env` (or the Console:
#    Cloud Functions → edit function → Runtime environment variables).
# 3. Re-run the deploy so params/secrets are attached to all functions.
#
# If a function lists a secret in its `secrets: [...]` option but the secret
# has not been created, `firebase deploy` fails with "Secret ... not found".
# If a param is missing, `param.value()` throws at runtime, so every function
# call fails until it is set.

# ── Secrets (set via `firebase functions:secrets:set`, not here) ─────────────
# Telegram Bot API token (from @BotFather). Required by nearly every function
# (bot messages: order created/cancelled, reward codes, broadcasts, webhook).
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
# TELEGRAM_BOT_TOKEN=

# Shared secret that guards the Telegram bot webhook. Set it in @BotFather
# (Menu → Bot Settings → Privacy/Webhooks → set secret token) AND here; the
# webhook rejects any request missing the matching X-Telegram-Bot-Api-Secret-
# Token header (403 Forbidden).
#   firebase functions:secrets:set TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_WEBHOOK_SECRET=

# ── Plain params (set in functions/.env or the Cloud Console) ────────────────
# Comma-separated Telegram user IDs allowed to manage the store (server-side
# admin gate, shared with the client's VITE_TELEGRAM_ADMIN_IDS). Empty means
# no admins — the admin panel is locked for everyone.
TELEGRAM_ADMIN_IDS=123456789,987654321

# Full URL of the deployed Mini App, e.g. https://your-app.web.app. Used as the
# `web_app` / link button target in bot messages (store welcome/shortcut).
# Required — bot flows throw "TELEGRAM_MINI_APP_URL is not configured" without it.
TELEGRAM_MINI_APP_URL=https://your-project-id.web.app

# Optional: max age (seconds) of Telegram initData accepted for HMAC
# verification. Defaults to 3600 (1 hour) if unset or invalid.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
