rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidCategory(category) {
      return category in ['hoodies', 'tshirts', 'outerwear', 'accessories', 'other'];
    }

    function isShortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalShortString(value, maxLength) {
      return !(value is string) || value.size() <= maxLength;
    }

    function isStringList(values, maxItems, maxLength) {
      return values is list
        && values.size() <= maxItems
        && values.join('').size() <= maxItems * maxLength;
    }

    function isPromoDiscountType(value) {
      return value in ['percentage', 'fixed_amount'];
    }

    function isPaymentMethod(value) {
      return value in ['meetup_cash', 'usdt'];
    }

    function isFulfillmentType(value) {
      return value in ['delivery', 'meetup'];
    }

    function isOrderStatus(value) {
      return value in [
        'new',
        'waiting_for_payment',
        'paid',
        'ready_for_meetup',
        'completed',
        'cancelled'
      ];
    }

    function isProductDocument(data) {
      return data.keys().hasOnly([
          'name',
          'description',
          'category',
          'brandNames',
          'price',
          'currency',
          'isAvailable',
          'likesCount',
          'cartCount',
          'images',
          'createdAt',
          'isLimitedLabel',
          'upcoming',
          'earlyAccessAt',
          'publicAt'
        ])
        && isShortString(data.name, 120)
        && isShortString(data.description, 2000)
        && isValidCategory(data.category)
        && isStringList(data.brandNames, 10, 60)
        && data.price is number
        && data.price >= 0
        && data.price <= 100000
        && data.currency == 'EUR'
        && data.isAvailable is bool
        && data.likesCount is number
        && data.likesCount >= 0
        && data.cartCount is number
        && data.cartCount >= 0
        && isStringList(data.images, 8, 2000)
        && data.createdAt is timestamp
        && (!('isLimitedLabel' in data) || isOptionalShortString(data.isLimitedLabel, 80))
        && (!('upcoming' in data) || data.upcoming is bool)
        && (!('earlyAccessAt' in data) || data.earlyAccessAt == null || data.earlyAccessAt is string)
        && (!('publicAt' in data) || data.publicAt == null || data.publicAt is string);
    }

    function isPromoDocument(data) {
      return data.keys().hasOnly([
          'code',
          'discountType',
          'discountValue',
          'isActive',
          'expiresAt',
          'usageLimit',
          'usageCount'
        ])
        && isShortString(data.code, 40)
        && isPromoDiscountType(data.discountType)
        && data.discountValue is number
        && data.discountValue > 0
        && data.discountValue <= 100000
        && data.isActive is bool
        && (!('expiresAt' in data) || data.expiresAt == null || data.expiresAt is timestamp)
        && (!('usageLimit' in data) || data.usageLimit == null || (data.usageLimit is number && data.usageLimit >= 0))
        && (!('usageCount' in data) || (data.usageCount is number && data.usageCount >= 0));
    }

    function isOrderItemList(items) {
      return items is list && items.size() > 0 && items.size() <= 12;
    }

    function isAppliedPromo(data) {
      return data == null
        || (
          data is map
          && data.keys().hasOnly([
            'code',
            'discountType',
            'discountValue',
            'discountAmount'
          ])
          && isShortString(data.code, 40)
          && isPromoDiscountType(data.discountType)
          && data.discountValue is number
          && data.discountAmount is number
          && data.discountAmount >= 0
        );
    }

    function isOrderDocument(data) {
      return data.keys().hasOnly([
          'fullName',
          'telegramHandle',
          'telegramUserId',
          'note',
          'fulfillmentType',
          'paymentMethod',
          'deliveryCity',
          'deliveryAddress',
          'deliveryNotes',
          'meetupLocation',
          'meetupTimeOption',
          'meetupNotes',
          'items',
          'subtotal',
          'appliedPromo',
          'total',
          'status',
          'cancelReason',
          'createdAt'
        ])
        && isShortString(data.fullName, 120)
        && isShortString(data.telegramHandle, 80)
        && data.note is string
        && data.note.size() <= 1000
        && isFulfillmentType(data.fulfillmentType)
        && isPaymentMethod(data.paymentMethod)
        && data.deliveryCity is string
        && data.deliveryCity.size() <= 120
        && data.deliveryAddress is string
        && data.deliveryAddress.size() <= 240
        && data.deliveryNotes is string
        && data.deliveryNotes.size() <= 1000
        && data.meetupLocation is string
        && data.meetupLocation.size() <= 80
        && data.meetupTimeOption is string
        && data.meetupTimeOption.size() <= 80
        && data.meetupNotes is string
        && data.meetupNotes.size() <= 1000
        && isOrderItemList(data.items)
        && data.subtotal is number
        && data.subtotal >= 0
        && isAppliedPromo(data.appliedPromo)
        && data.total is number
        && data.total >= 0
        && isOrderStatus(data.status)
        && data.cancelReason is string
        && data.cancelReason.size() <= 500
        && data.createdAt is timestamp
        && (!('telegramUserId' in data) || data.telegramUserId == null || data.telegramUserId is int);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if false;

      // Per-user popularity signals (likes / cart) — all access via Cloud Functions
      match /signals/{userId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    // promoCodes — codes, limits and usage counts are confidential. All access
    // is via Cloud Functions only: buyers validate through /api/promos/validate,
    // admins manage + list through /api/admin/*.
    match /promoCodes/{promoCodeId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow create: if false;
      allow update: if false;
      allow read: if false;
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /giveaways/{giveawayId} {
      allow read: if true;
      allow create, update, delete: if false;

      // Subcollection for giveaway entries — all access via Cloud Functions only
      match /entries/{entryId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /telegramSubscribers/{subscriberId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /userRewards/{rewardId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // userStats — per-user server-tracked counters (liked product count used
    // to verify giveaway "like N products" tasks). All access via Cloud
    // Functions only; the device can never write its own proof.
    match /userStats/{userId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ── Privacy & Consent Collections ──

    // userConsent — stores GDPR consent records. All access via Cloud Functions only.
    match /userConsent/{consentId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // userSettings — stores user privacy preferences (leaderboard visibility, etc.). All access via Cloud Functions only.
    match /userSettings/{settingId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // dailyCheckins — stores daily check-in state. All access via Cloud Functions only.
    match /dailyCheckins/{userId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    // presence — realtime online user counter. Readable by all, but only
    // Cloud Functions may write (server-verified heartbeat, M6) so the counter
    // can never be inflated with fake docs.
    match /presence/{userId} {
      allow read: if true;
      allow create, update, delete: if false;
    }
  }
}
