{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/verifyTelegramAdmin",
        "function": {
          "functionId": "verifyTelegramAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/updateOrderStatus",
        "function": {
          "functionId": "updateOrderStatusAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/listOrders",
        "function": {
          "functionId": "listOrdersAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/orders/listMine",
        "function": {
          "functionId": "listBuyerOrders",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/upsertPromoCode",
        "function": {
          "functionId": "upsertPromoCodeAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/deletePromoCodes",
        "function": {
          "functionId": "deletePromoCodesAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/upsertProduct",
        "function": {
          "functionId": "upsertProductAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/deleteProducts",
        "function": {
          "functionId": "deleteProductsAdmin",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/checkout/createOrder",
        "function": {
          "functionId": "createCheckoutOrder",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/products/updateSignal",
        "function": {
          "functionId": "updateProductSignal",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/admin/uploadProductImage",
        "function": {
          "functionId": "uploadProductImageAdmin",
          "region": "us-central1"
        }
      },
    {
      "source": "/api/admin/deleteProductImages",
      "function": {
        "functionId": "deleteProductImagesAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/sendBroadcast",
      "function": {
        "functionId": "broadcastMessageAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/uploadBannerImage",
      "function": {
        "functionId": "uploadBannerImageAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/analytics",
      "function": {
        "functionId": "getAdminAnalytics",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/upsertCampaign",
      "function": {
        "functionId": "upsertCampaignAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/deleteCampaigns",
      "function": {
        "functionId": "deleteCampaignsAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/reorderCampaigns",
      "function": {
        "functionId": "reorderCampaignsAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/upsertTask",
      "function": {
        "functionId": "upsertTaskAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/deleteTasks",
      "function": {
        "functionId": "deleteTasksAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/upsertGiveaway",
      "function": {
        "functionId": "upsertGiveawayAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/admin/deleteGiveaways",
      "function": {
        "functionId": "deleteGiveawaysAdmin",
        "region": "us-central1"
      }
    },
    {
      "source": "/api/telegram/webhook",
        "function": {
          "functionId": "telegramBotWebhook",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
