VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_TELEGRAM_ADMIN_IDS=123456789
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
VITE_TELEGRAM_BOT_START=store
VITE_TELEGRAM_BOT_STARTAPP=store
# Browser admin fallback now works only on localhost dev when this is true.
VITE_ENABLE_ADMIN_IN_BROWSER=false
# Optional override for the deployed Telegram admin verification endpoint.
VITE_VERIFY_TELEGRAM_ADMIN_URL=/api/verifyTelegramAdmin
# Optional override for the admin order status update endpoint.
VITE_ADMIN_UPDATE_ORDER_STATUS_URL=/api/admin/updateOrderStatus
# Optional override for the admin order listing endpoint.
VITE_ADMIN_LIST_ORDERS_URL=/api/admin/listOrders
# Optional override for the buyer order listing endpoint.
VITE_LIST_BUYER_ORDERS_URL=/api/orders/listMine
# Optional override for the admin promo upsert endpoint.
VITE_ADMIN_UPSERT_PROMO_URL=/api/admin/upsertPromoCode
# Optional override for the admin promo delete endpoint.
VITE_ADMIN_DELETE_PROMOS_URL=/api/admin/deletePromoCodes
# Optional override for the admin product upsert endpoint.
VITE_ADMIN_UPSERT_PRODUCT_URL=/api/admin/upsertProduct
# Optional override for the admin product delete endpoint.
VITE_ADMIN_DELETE_PRODUCTS_URL=/api/admin/deleteProducts
# Optional override for the checkout create order endpoint.
VITE_CREATE_CHECKOUT_ORDER_URL=/api/checkout/createOrder
# Optional override for product signal updates like likes/cart counters.
VITE_UPDATE_PRODUCT_SIGNAL_URL=/api/products/updateSignal
# Optional override for admin product image upload.
VITE_ADMIN_UPLOAD_PRODUCT_IMAGE_URL=/api/admin/uploadProductImage
# Optional override for admin product image delete.
VITE_ADMIN_DELETE_PRODUCT_IMAGES_URL=/api/admin/deleteProductImages
