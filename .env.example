VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_TELEGRAM_ADMIN_IDS=123456789
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
VITE_TELEGRAM_BOT_START=store
VITE_TELEGRAM_BOT_STARTAPP=store
# Browser admin fallback now works only on localhost dev when this is true.
VITE_ENABLE_ADMIN_IN_BROWSER=false
# ── Dev mock Telegram user (used when VITE_ENABLE_ADMIN_IN_BROWSER is true) ──
# VITE_DEV_TELEGRAM_USER_ID=123456789
# VITE_DEV_TELEGRAM_USERNAME=dev_user
# VITE_DEV_TELEGRAM_FIRST_NAME=Dev
# VITE_DEV_TELEGRAM_LANGUAGE_CODE=en
# Optional override for the deployed Telegram admin verification endpoint.
VITE_VERIFY_TELEGRAM_ADMIN_URL=/api/verifyTelegramAdmin
# Optional override for the admin order status update endpoint.
VITE_ADMIN_UPDATE_ORDER_STATUS_URL=/api/admin/updateOrderStatus
# Optional override for the admin order listing endpoint.
VITE_ADMIN_LIST_ORDERS_URL=/api/admin/listOrders
# Optional override for the buyer order listing endpoint.
VITE_LIST_BUYER_ORDERS_URL=/api/orders/listMine
# Optional override for the admin promo upsert endpoint.
VITE_ADMIN_UPSERT_PROMO_URL=/api/admin/upsertPromoCode
# Optional override for the admin promo delete endpoint.
VITE_ADMIN_DELETE_PROMOS_URL=/api/admin/deletePromoCodes
# Optional override for the admin promo listing endpoint.
VITE_ADMIN_LIST_PROMOS_URL=/api/admin/listPromoCodes
# Optional override for the buyer promo validation endpoint.
VITE_VALIDATE_PROMO_URL=/api/promos/validate
# Optional override for the admin product upsert endpoint.
VITE_ADMIN_UPSERT_PRODUCT_URL=/api/admin/upsertProduct
# Optional override for the admin product delete endpoint.
VITE_ADMIN_DELETE_PRODUCTS_URL=/api/admin/deleteProducts
# Optional override for the admin product discount endpoint (percent or fixed amount off).
VITE_ADMIN_SET_PRODUCT_DISCOUNT_URL=/api/admin/setProductDiscount
# Optional override for the checkout create order endpoint.
VITE_CREATE_CHECKOUT_ORDER_URL=/api/checkout/createOrder
# Optional override for product signal updates like likes/cart counters.
VITE_UPDATE_PRODUCT_SIGNAL_URL=/api/products/updateSignal
# Server-verified online presence heartbeat.
VITE_UPDATE_PRESENCE_URL=/api/presence/heartbeat
# Optional override for admin product image upload.
VITE_ADMIN_UPLOAD_PRODUCT_IMAGE_URL=/api/admin/uploadProductImage
# Optional override for admin product image delete.
VITE_ADMIN_DELETE_PRODUCT_IMAGES_URL=/api/admin/deleteProductImages

# ── Additional Admin API Endpoints (optional overrides) ──
VITE_ADMIN_UPLOAD_BANNER_IMAGE_URL=/api/admin/uploadBannerImage
VITE_ADMIN_ANALYTICS_URL=/api/admin/analytics
VITE_SEND_BROADCAST_URL=/api/admin/sendBroadcast
VITE_DELETE_BROADCAST_URL=/api/admin/deleteBroadcast

# ── Campaigns, Giveaways & Tasks Admin (optional overrides) ──
VITE_UPSERT_CAMPAIGN_URL=/api/admin/upsertCampaign
VITE_DELETE_CAMPAIGNS_URL=/api/admin/deleteCampaigns
VITE_REORDER_CAMPAIGNS_URL=/api/admin/reorderCampaigns
VITE_UPSERT_GIVEAWAY_URL=/api/admin/upsertGiveaway
VITE_DELETE_GIVEAWAYS_URL=/api/admin/deleteGiveaways
VITE_UPSERT_TASK_URL=/api/admin/upsertTask
VITE_DELETE_TASKS_URL=/api/admin/deleteTasks

# ── New Feature API Endpoints (optional overrides) ──
VITE_REFERRAL_INFO_URL=/api/referral/info

# ── Broadcast Subscription (buyer opt-in) ──
VITE_TOGGLE_BROADCAST_URL=/api/notify/toggleBroadcast

# ── Giveaway Image Upload (optional override) ──
VITE_ADMIN_UPLOAD_GIVEAWAY_IMAGE_URL=/api/admin/uploadGiveawayImage

# ── GDPR / Privacy Endpoints (optional overrides) ──
VITE_USER_CONSENT_URL=/api/user/consent
VITE_USER_SETTINGS_URL=/api/user/settings

# ── Cloud Functions env (do NOT set VITE_* vars for the backend) ────────────
# The Functions runtime reads its own variables (declared in
# functions/src/helpers.ts). The canonical template with setup instructions
# (including the two REQUIRED secrets and the deploy checklist) lives at:
#
#   functions/.env.example   →  copy to functions/.env
#
# Required before `firebase deploy --only functions`:
#   firebase functions:secrets:set TELEGRAM_BOT_TOKEN
#   firebase functions:secrets:set TELEGRAM_WEBHOOK_SECRET
#   TELEGRAM_ADMIN_IDS, TELEGRAM_MINI_APP_URL (params, set in functions/.env)
#   TELEGRAM_INIT_DATA_MAX_AGE_SECONDS (optional, defaults to 3600)
